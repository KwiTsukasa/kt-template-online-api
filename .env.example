DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=shy_template
DB_SYNC=true
DB_TIMEZONE=+08:00

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kt-template-online
BLOG_LIVE2D_BUCKET=kt-template-online
BLOG_LIVE2D_PREFIX=blog/live2d/pio
# 旧 Blog 资源迁移仅允许精确 Host，不支持通配符；正常 API 启动不要求配置。
BLOG_ASSET_MIGRATION_ALLOWED_HOSTS=legacy-blog.example.com,legacy-cdn.example.com
BLOG_ASSET_MIGRATION_MAX_REDIRECTS=3
BLOG_ASSET_MIGRATION_TIMEOUT_MS=10000
BLOG_ASSET_MIGRATION_MAX_BYTES=10485760

ADMIN_TOKEN_SECRET=change-me
ADMIN_COOKIE_SECURE=false
# 仅允许本机非生产开发临时使用；production 永远拒绝 HTTP 认证请求。
ADMIN_AUTH_ALLOW_INSECURE_LOCAL=false
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1

# Admin-managed LLM credentials are encrypted at rest; production values stay in runtime Secrets.
LLM_CONFIG_SECRET_KEY=
# Unified API/media-governance -> local Codex gateway secret.
LLM_CODEX_GATEWAY_INTERNAL_SECRET=
# Only this private gateway Base URL can receive the Codex internal secret.
LLM_CODEX_GATEWAY_BASE_URL=http://127.0.0.1:48087/internal/llm-codex
LLM_CODEX_GATEWAY_TIMEOUT_MS=20000
# Optional local Codex read-only working directory; empty uses the managed gateway default.
LLM_CODEX_CHAT_CWD=

# Admin SSO issues two-minute tokens for the single Windows Desktop Relay.
CODEX_REMOTE_PC_WS_URL=ws://10.66.66.4:48095
CODEX_REMOTE_PC_WS_SHARED_SECRET=
CODEX_REMOTE_PC_PROJECTS_JSON=[{"id":"kt","label":"KT Workspace","cwd":"/home/user/KT"}]

# Public gateway security boundary. Production values must use exact IPs only.
PUBLIC_SECURITY_TRUSTED_PROXY_IPS=127.0.0.1,::1,10.66.66.1
PUBLIC_SECURITY_SWAGGER_ALLOWLIST=127.0.0.1,::1
PUBLIC_RATE_LIMIT_REDIS_HOST=127.0.0.1
PUBLIC_RATE_LIMIT_REDIS_PORT=6379
PUBLIC_RATE_LIMIT_REDIS_PASSWORD=
PUBLIC_RATE_LIMIT_REDIS_DB=0
PUBLIC_RATE_LIMIT_REDIS_KEY_PREFIX=kt:public-rate-limit
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_PUBLIC_READ_LIMIT=60
PUBLIC_RATE_LIMIT_BASELINE_LIMIT=300
PUBLIC_RATE_LIMIT_WARNING_INTERVAL_MS=30000
PUBLIC_RATE_LIMIT_LOGIN_IP_LIMIT=5
PUBLIC_RATE_LIMIT_LOGIN_IP_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_LOGIN_USERNAME_LIMIT=10
PUBLIC_RATE_LIMIT_LOGIN_USERNAME_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_LOGIN_GLOBAL_LIMIT=100
PUBLIC_RATE_LIMIT_LOGIN_GLOBAL_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_REFRESH_SUBJECT_LIMIT=30
PUBLIC_RATE_LIMIT_REFRESH_SUBJECT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_LOGOUT_SUBJECT_LIMIT=10
PUBLIC_RATE_LIMIT_LOGOUT_SUBJECT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_LIVE2D_CONCURRENT_LIMIT=8
PUBLIC_RATE_LIMIT_LIVE2D_CONCURRENT_LEASE_MS=120000

# System network-management control plane; credentials come from runtime Secret.
NETWORK_AGENT_ID=nas-main
NETWORK_AGENT_TARGET_IPV4=192.168.31.224
NETWORK_AGENT_MQTT_URL=
NETWORK_AGENT_MQTT_CLIENT_ID=kt-template-online-api-network-nas-main
NETWORK_AGENT_MQTT_USERNAME=
NETWORK_AGENT_MQTT_PASSWORD=
NETWORK_AGENT_MQTT_RETRY_MS=5000
NETWORK_TCP_NATMAP_RELEASE_MODE=off
NETWORK_TCP_NATMAP_CANARY_PORTS=

# Optional Tencent Cloud DNS DDNS; credentials must come from a private runtime Secret.
NETWORK_DDNS_DNSPOD_ENABLED=false
NETWORK_DDNS_DNSPOD_SECRET_ID=
NETWORK_DDNS_DNSPOD_SECRET_KEY=
NETWORK_DDNS_RECONCILE_INTERVAL_MS=60000
NETWORK_DDNS_AGENT_IPV6_MAX_AGE_MS=60000

LOG_LEVEL=info
LOG_APP_NAME=kt-template-online-api
LOG_PRETTY=true
LOKI_URL=
LOKI_QUERY_HOST=
LOKI_ENV=development
LOKI_TENANT_ID=
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_PUSH_ENDPOINT=/loki/api/v1/push
LOKI_QUERY_ENDPOINT=/loki/api/v1/query_range
LOKI_PUSH_TIMEOUT_MS=30000
LOKI_QUERY_TIMEOUT_MS=10000
LOKI_BATCH_INTERVAL_SECONDS=5
LOKI_BATCH_MAX_BUFFER_SIZE=10000
LOKI_QUERY_MAX_LIMIT=1000
LOKI_QUERY_SELECTOR=
LOKI_SILENCE_ERRORS=true

BOT_ENABLED=false
BOT_ACCOUNT_SECRET_KEY=
# Webhook 模式必须配置为不经中转的 NAS 公网 HTTPS API 基址，端口只允许 80/443/8080/8443。
TENCENT_BOT_WEBHOOK_PUBLIC_BASE_URL=
BOT_EVENT_BUS=mqtt
BOT_REVERSE_WS_PATH=/bot-adapter/napcat/onebot/reverse
BOT_REVERSE_WS_TOKEN=
BOT_AUTO_REGISTER_ACCOUNT=true
BOT_API_TIMEOUT_MS=10000
BOT_SEND_RATE_PER_SECOND=1
BOT_SEND_GLOBAL_INTERVAL_MS=2500
BOT_SEND_TARGET_INTERVAL_MS=8000
BOT_SEND_JITTER_MS=800
BOT_SEND_MAX_QUEUE_WAIT_MS=30000
# K8s production can use PLUGIN_QUEUE_REDIS_HOST=kt-plugin-redis.
PLUGIN_QUEUE_REDIS_HOST=127.0.0.1
PLUGIN_QUEUE_REDIS_PORT=6379
PLUGIN_QUEUE_REDIS_PASSWORD=
PLUGIN_QUEUE_REDIS_DB=0
PLUGIN_QUEUE_REDIS_PREFIX=kt:plugin:plugin-worker
PLUGIN_QUEUE_REMOVE_ON_FAIL=100
PLUGIN_QUEUE_WAIT_BUFFER_MS=5000
PLUGIN_QUEUE_WAIT_TIMEOUT_MS=120000
# Plugin scheduled task queue. Defaults reuse PLUGIN_QUEUE_REDIS_* when host/port/password/db are empty.
PLUGIN_TASK_QUEUE_REDIS_HOST=
PLUGIN_TASK_QUEUE_REDIS_PORT=
PLUGIN_TASK_QUEUE_REDIS_PASSWORD=
PLUGIN_TASK_QUEUE_REDIS_DB=
PLUGIN_TASK_QUEUE_REDIS_PREFIX=kt:plugin:plugin-task
BOT_COMMAND_MIN_COOLDOWN_MS=5000
BOT_RULE_MIN_COOLDOWN_MS=30000
PLUGIN_REPEATER_THRESHOLD=4
PLUGIN_REPEATER_MAX_TEXT_LENGTH=120
PLUGIN_REPEATER_MIN_INTERVAL_MS=600000
PLUGIN_REPEATER_STATE_TTL_MS=600000
PLUGIN_REPEATER_CONFIG_CACHE_TTL_MS=2000
NAPCAT_WEBUI_BASE_URL=http://127.0.0.1:6099
NAPCAT_WEBUI_TOKEN=
NAPCAT_WEBUI_TIMEOUT_MS=8000
NAPCAT_LOGIN_QR_EXPIRE_MS=120000
NAPCAT_LOGIN_HUMAN_VERIFY_EXPIRE_MS=900000
NAPCAT_WEBUI_READY_RETRIES=10
NAPCAT_WEBUI_RESTART_DELAY_MS=3000
NAPCAT_WEBUI_GATEWAY_INTERNAL_BASE_URL=http://127.0.0.1:48086
NAPCAT_WEBUI_GATEWAY_INTERNAL_SECRET=
NAPCAT_WEBUI_GATEWAY_PUBLIC_BASE_URL=/admin/napcat-webui
NAPCAT_WEBUI_GATEWAY_PORT=48086
NAPCAT_WEBUI_GATEWAY_REDIS_HOST=127.0.0.1
NAPCAT_WEBUI_GATEWAY_REDIS_PORT=6379
NAPCAT_WEBUI_GATEWAY_SESSION_TTL_MS=60000
NAPCAT_WEBUI_GATEWAY_TICKET_TTL_MS=60000
NAPCAT_WEBUI_GATEWAY_TIMEOUT_MS=5000
NAPCAT_WEBUI_GATEWAY_UPSTREAM_TIMEOUT_MS=5000
# 留空时使用密码登录等待窗口 + WebUI 重启/请求缓冲 + 2 个轮询间隔。
NAPCAT_RELOGIN_PREPARING_STALE_MS=
NAPCAT_CONTAINER_MODE=
NAPCAT_SSH_TARGET=nas
NAPCAT_SSH_PORT=
NAPCAT_SSH_KEY_PATH=
NAPCAT_SSH_TIMEOUT_MS=120000
NAPCAT_ROOT=/vol1/docker/kt-bot/napcat-instances
NAPCAT_IMAGE=
NAPCAT_CONTAINER_PREFIX=kt-bot-napcat
NAPCAT_HOST=192.168.31.224
NAPCAT_PORT_START=6100
NAPCAT_PORT_END=6199
NAPCAT_BASE_URL_TEMPLATE=http://192.168.31.224:{port}
NAPCAT_REVERSE_WS_BASE=ws://192.168.31.224:48085/bot-adapter/napcat/onebot/reverse
# 离线看门狗：定时巡检在线账号，掉线/被踢及时触发站内信告警（true/false，默认开启）
NAPCAT_WATCHDOG_ENABLED=true
# 看门狗巡检间隔毫秒，最小 30000，默认 120000
NAPCAT_WATCHDOG_INTERVAL_MS=120000

