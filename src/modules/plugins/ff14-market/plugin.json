{
  "pluginKey": "ff14-market",
  "name": "FF14 市场价格",
  "version": "1.3.0",
  "minApiSdkVersion": "1.0.0",
  "description": "对接 XIVAPI v2 与 Universalis，提供 FF14 物品解析和市场价格查询能力。",
  "author": "KT",
  "entry": "src/index.ts",
  "legacyAliases": ["ff14Market"],
  "permissions": [
    "runtime.http",
    "plugin.config.read",
    "plugin.storage.read",
    "plugin.storage.write"
  ],
  "runtime": {
    "workerType": "thread",
    "timeoutMs": 300000,
    "memoryMb": 256,
    "maxConcurrency": 1,
    "configKeys": [
      "FF14_DEFAULT_WORLD",
      "FF14_UNIVERSALIS_BASE_URL",
      "FF14_XIVAPI_BASE_URL",
      "FF14_XIVAPI_CHS_BASE_URL",
      "FF14_CHINESE_ITEM_DATA_URL"
    ]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "xivapiBaseUrl": {
        "type": "string"
      },
      "universalisBaseUrl": {
        "type": "string"
      },
      "defaultWorld": {
        "type": "string"
      }
    }
  },
  "operations": [
    {
      "key": "ff14.item.resolve",
      "name": "解析物品",
      "handlerName": "resolveItem",
      "description": "按名称或ID解析物品；候选查询：/物品 search=发型样式，返回正式名称、ID和数据版本，不自动替用户认定模糊候选。",
      "aliases": ["物品", "item", "ff14item"],
      "permissions": ["runtime.http", "plugin.config.read"],
      "timeoutMs": 90000,
      "inputSchema": {
        "x-agent-read-only": true,
        "properties": {
          "item": {
            "description": "物品名称或 ID",
            "type": "string"
          },
          "itemId": {
            "description": "物品 ID",
            "type": "number"
          },
          "language": {
            "default": "chs",
            "type": "string"
          },
          "raw": {
            "type": "string",
            "description": "物品名称或ID；search=关键词返回候选列表"
          }
        },
        "type": "object",
        "anyOf": [
          {
            "required": ["item"]
          },
          {
            "required": ["itemId"]
          },
          {
            "required": ["raw"]
          }
        ]
      }
    },
    {
      "key": "ff14.market.price",
      "name": "市场查价",
      "handlerName": "getPrice",
      "description": "查价：/查价 用户原始物品名、简称或ID，默认已配置地区，不自行补写正式名称。每日全区销量前20：/查价 mode=stats date=YYYY-MM-DD metric=quantity world=中国；不指定物品范围会自动查询完整可交易物品目录并排名。成交笔数用metric=transactions，成交额用turnover，均价用weightedAverage；date为北京时间自然日，days为最近天数。也支持items=ID1,ID2、category=名称关键词或searchCategory=市场分类缩小范围。全目录首次扫描可能需要数分钟。status=pending时自动继续同一命令，复用持久检查点；未扫描完没有榜单。相同查询15分钟内复用首次固定时间窗口及已完成结果，range与updatedAt为准。结果由代码计算，带扫描覆盖、缺失和截断项；仅代表Universalis玩家上传成交。模糊多义先/物品 search=用户原始关键词查真实候选。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "raw": {
            "type": "string",
            "description": "命令后面的原始参数；只查物品时填写物品名称或ID，例如小鸣鼠角笛。"
          }
        },
        "required": ["raw"],
        "x-agent-read-only": true
      },
      "aliases": ["查价", "price", "ff14price"],
      "permissions": [
        "runtime.http",
        "plugin.config.read",
        "plugin.storage.read",
        "plugin.storage.write"
      ],
      "timeoutMs": 290000
    }
  ],
  "events": [],
  "assets": [],
  "migrations": []
}
