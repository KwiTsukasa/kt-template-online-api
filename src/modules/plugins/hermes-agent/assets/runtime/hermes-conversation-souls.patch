+async def _kt_conversation_souls(name: str, payload=None):
+    """复用认证路由与档案定位，只将有界输入交给 Node 持久化执行器。"""
+    home = _resolve_profile_dir(name)
+    method = "read"
+    if payload is not None:
+        method = "write"
+    process = await asyncio.create_subprocess_exec(
+        "flock", "-w", "5", str(home / ".kt-conversation-souls.lock"),
+        "node", "/opt/kt-tools/conversation-souls.mjs", method, str(home),
+        stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
+        stderr=asyncio.subprocess.PIPE,
+    )
+    try:
+        output, error = await asyncio.wait_for(process.communicate(payload), timeout=8)
+    except asyncio.TimeoutError:
+        process.kill()
+        await process.wait()
+        raise HTTPException(status_code=504, detail="Conversation SOUL publish timeout")
+    if process.returncode:
+        raise HTTPException(status_code=409, detail="Conversation SOUL validation or revision conflict")
+    return json.loads(output)
+
+
+@router.get("/api/profiles/{name}/conversation-souls")
+async def get_conversation_souls(name: str):
+    """返回原子发布清单的版本与摘要，不输出人格正文。"""
+    return await _kt_conversation_souls(name)
+
+
+@router.put("/api/profiles/{name}/conversation-souls")
+async def put_conversation_souls(name: str, request: Request):
+    """限制输入大小后提交 Node 执行器，选择状态仍由 API 管理。"""
+    payload = bytearray()
+    async for chunk in request.stream():
+        payload.extend(chunk)
+        if len(payload) > 48 * 1024:
+            raise HTTPException(status_code=413, detail="Conversation SOUL payload too large")
+    return await _kt_conversation_souls(name, bytes(payload))
+
+
